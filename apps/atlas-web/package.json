{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "auth:schema": "dotenv -e ../../.env -- auth generate --config src/lib/auth.ts --output ../../packages/database/src/auth-schema.ts --yes"
  },
  "dependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/database": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "auth": "1.6.25",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
