{
  "name": "@atlas/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "auth:schema": "dotenv -e ../../.env -- auth generate --config src/lib/auth.ts --output ../../packages/database/src/auth-schema.ts --yes"
  },
  "dependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/database": "workspace:*",
    "better-auth": "^1.6.25",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "auth": "1.6.25",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  }
}
