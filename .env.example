# atlas-web
ATLAS_INDEXER_URL=http://localhost:4000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub App's URL slug, used to build the installation URL.
GITHUB_APP_SLUG=

# atlas-indexer
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@host/database

# GitHub App credentials. These stay in atlas-indexer; atlas-web never reads them.
GITHUB_APP_ID=

# Supply the private key one of two ways. Set the path for local development:
# drop the downloaded .pem in the repository root (*.pem is gitignored) and
# point at it. Paths are resolved from the repository root, whichever service
# reads them.
GITHUB_PRIVATE_KEY_PATH=atlas.private-key.pem

# Or set the key itself, for deployments with no filesystem to hold a file.
# Accepts a raw PEM or a single-line base64 encoding of one:
#   base64 -i atlas.private-key.pem | tr -d '\n'
# GITHUB_PRIVATE_KEY_PATH wins when both are set.
GITHUB_PRIVATE_KEY=

# Unused until the webhook milestone, but generated with the App.
GITHUB_WEBHOOK_SECRET=

# Shared secret authenticating atlas-web -> atlas-indexer commands. Server-only,
# never exposed to the browser. Generate with: openssl rand -hex 32
ATLAS_SERVICE_TOKEN=
